# Copy this file to .env and fill in your own values. Everything here is
# optional — unset variables fall back to the defaults shown in proxy.js.
#
# WARNING: never commit .env; it is gitignored and holds your private values.

# Base path under which the proxy is reached on code-server, i.e. the
# /proxy/<port>/ subtree code-server forwards to this service.
PROXY_BASE=/proxy/3101

# Where the proxy listens (browser-facing, inside code-server's network).
PROXY_PORT=3101

# The kimi web upstream this proxy forwards to.
PROXY_UPSTREAM_HOST=127.0.0.1
PROXY_UPSTREAM_PORT=58627

# Set to 0 to NOT auto-spawn `kimi web` when the upstream is not running
# (e.g. when kimi is supervised by systemd / pm2 / a restart helper).
# PROXY_SPAWN_KIMI=0

# Optional: your code-server hostname. When set, the proxy prints the full
# clickable access URL (with the kimi auth token) at startup.
# PROXY_EXTERNAL_HOST=code.yourdomain.com
